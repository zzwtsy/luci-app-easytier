
config easytier
	option enabled '0'
	option easytierbin '/usr/bin/easytier-core'
	option auto_config_interface '1'
	option auto_config_firewall '1'
	option interface_netmask '255.0.0.0'
	option log 'off'
	option check '0'
	option checktime '2'
	option web_enabled '0'
	option webbin '/usr/bin/easytier-web'
